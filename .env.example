# Supabase (server-side only — never expose the service role key to the browser)
SUPABASE_URL=https://oujqkygfmyapmrgxmhvt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Bearer token required on every API endpoint (min 16 chars). Generate: openssl rand -hex 24
API_AUTH_TOKEN=

# Tuning (optional)
RAG_MATCH_COUNT=6
RAG_MIN_SIMILARITY=0.2
CRAWL_MAX_PAGES=20
UPLOAD_MAX_MB=10
